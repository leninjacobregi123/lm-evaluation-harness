# ==============================================================================
#   LM Evaluation Harness Wrapper Dashboard — Environment Variables Configuration
# ==============================================================================
#
#   Copy this file to `.env` in the project root and populate keys as needed:
#   cp .env.example .env
#

# ── API Keys & Credentials ──────────────────────────────────────────────────
# Standard API keys used to call model endpoints (OpenAI, Anthropic) or load HuggingFace models.
# Note: You can also manage and save these keys locally within the web interface (Credentials Wallet).
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
HF_TOKEN=your-huggingface-token-here

# ── Service Endpoints ────────────────────────────────────────────────────────
# Default URL to the local Ollama instance (change if hosting on a remote port/server)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Hardware & Optimization Settings ─────────────────────────────────────────
# Enable automatic model optimization fallback checks
HF_ALLOW_CODE_EVAL=1
PYTHONUNBUFFERED=1
